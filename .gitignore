# dependencies
node_modules/

# build output — dist/ is intentionally TRACKED: `npm start` (node server.mjs) serves
# the committed build so a fresh clone answers HTTP with zero registry dependency.
dist-ssr/
build/

# env & secrets — .env is intentionally committed (public client values only)
.env
.env.*
!.env.example
!.env

# logs
logs/
*.log
npm-debug.log*

# editor/OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# caches
.cache/
.eslintcache
*.tsbuildinfo

# local scratch
/tmp
*.local

# factory harness session logs (ephemeral, not product work)
.pdf-sessions/
