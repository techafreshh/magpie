# Magpie env template.
#
# The browser app has NO configuration: every request is same-origin to the
# Magpie backend (server.mjs), and embeddings run on-device. Only the backend
# and the operator scripts take environment variables — none of them are
# secrets unless your Qdrant instance requires an API key.
#
# Where they live:
#   - Docker compose: environment block / compose .env (see compose.yaml)
#   - Local dev / operator scripts: .env.local (gitignored — never commit)

# Qdrant instance the backend and scripts talk to.
#   inside Docker (compose network): http://qdrant:6333
#   from the host: the container's IP on the docker network, e.g. http://10.0.1.x:6333
QDRANT_URL=
# Collection holding every report (single shared corpus).
QDRANT_COLLECTION=magpie_reports
# Optional — only when the Qdrant instance enforces an API key.
QDRANT_API_KEY=

# Port the backend listens on (default 8080; `npm run api` fixes it at 8787).
# PORT=

# Optional — dedupe-before-write boundary for the report flow.
# Must mirror THRESHOLDS.MERGE in src/lib/constants.ts (default 0.95).
# MERGE_THRESHOLD=

# Optional — base URL `npm run smoke` probes in online mode.
# MAGPIE_API_URL=http://127.0.0.1:8080
