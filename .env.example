# Magpie env template — copy to .env (public values) and .env.local (secrets).
#
# .env  — committed, public-by-design client values (safe to ship in the bundle)
VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=

# .env.local — gitignored, operator-only (seed/setup scripts). NEVER commit.
# Key scopes needed: vectorsdb (read/write), documents (write)
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=